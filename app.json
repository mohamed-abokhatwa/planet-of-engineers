{
  "expo": {
    "name": "Planet of Engineers",
    "slug": "planet-of-engineers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.abokhatwa.planetofengineers",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abokhatwa.planetofengineers",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "forcesRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A1A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Planet of Engineers uses your photos only when you choose to attach a picture of a technical problem to a Site SOS question.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "scheme": "planetofengineers",
    "backgroundColor": "#07111F",
    "owner": "abokhatwa",
    "description": "A home for engineers everywhere: offline tools, Site SOS answers, anonymous salary data and a daily challenge.",
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}